{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User specific stats and settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "currentStreak": { "type": "number" },
        "lastActiveDate": { "type": "string", "format": "date-time" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "pin": { "type": "string" }
      },
      "required": ["uid", "pin"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "cost": { "type": "number" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" },
        "lowStockThreshold": { "type": "number" },
        "imageUrl": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "cost", "price", "stock", "ownerId"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer contact info.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "notes": { "type": "string" },
        "totalSpent": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "ownerId"]
    },
    "Order": {
      "title": "Order",
      "description": "Sales order.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "delivered", "cancelled"] },
        "totalAmount": { "type": "number" },
        "profit": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["status", "totalAmount", "profit", "ownerId"]
    },
    "OrderItem": {
      "title": "Order Item",
      "description": "Item within an order.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "productId": { "type": "string" },
        "quantity": { "type": "number" },
        "priceAtPurchase": { "type": "number" },
        "costAtPurchase": { "type": "number" },
        "ownerId": { "type": "string" }
      },
      "required": ["orderId", "productId", "quantity", "priceAtPurchase", "costAtPurchase", "ownerId"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business expenditure.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["category", "amount", "ownerId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and stats"
    },
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "User's product inventory"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "User's customer database"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "Order",
      "description": "User's sales orders"
    },
    "/users/{userId}/orders/{orderId}/items/{itemId}": {
      "schema": "OrderItem",
      "description": "Items in a specific order"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "User's business expenses"
    }
  }
}
