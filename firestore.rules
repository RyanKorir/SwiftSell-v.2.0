             data.ownerId == userId &&
             data.status in ['pending', 'processing', 'delivered', 'cancelled'] &&
             data.totalAmount is number &&
             data.profit is number;
    }

    function isValidOrderItem(data, userId, orderId) {
      return data.keys().hasAll(['orderId', 'productId', 'quantity', 'priceAtPurchase', 'costAtPurchase', 'ownerId']) &&
             data.ownerId == userId &&
>>>>>>> 1aa9bfc46505429d68510ca35baadd2f6545327e
             data.orderId == orderId &&
             data.productId is string &&
             data.quantity is number && data.quantity > 0;
    }

    function isValidExpense(data, userId) {
<<<<<<< HEAD
      return data.ownerId == userId &&
=======
      return data.keys().hasAll(['category', 'amount', 'ownerId']) &&
             data.ownerId == userId &&
>>>>>>> 1aa9bfc46505429d68510ca35baadd2f6545327e
             data.category is string &&
             data.amount is number && data.amount >= 0;
    }

    // --- Match Groups ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
<<<<<<< HEAD
      allow update: if isOwner(userId) && (
        // Validation checks
        isValidUser(incoming()) && 
        (incoming().diff(existing()).affectedKeys().hasOnly(['pin']) ||
         incoming().diff(existing()).affectedKeys().hasAny(['xp', 'level', 'currentStreak', 'lastActiveDate', 'badges', 'email', 'displayName']))
=======
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Action: Change PIN
        (incoming().diff(existing()).affectedKeys().hasOnly(['pin'])) ||
        // Action: Update Stats
        (incoming().diff(existing()).affectedKeys().hasAny(['xp', 'level', 'currentStreak', 'lastActiveDate', 'badges']) &&
         incoming().xp >= existing().xp)
>>>>>>> 1aa9bfc46505429d68510ca35baadd2f6545327e
      );

      // Sub-collections
      match /products/{productId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(productId);
        allow create: if isOwner(userId) && isValidId(productId) && isValidProduct(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(productId) && isValidProduct(incoming(), userId) &&
                        incoming().ownerId == existing().ownerId;
        allow delete: if isOwner(userId) && isValidId(productId);
      }

      match /customers/{customerId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(customerId);
        allow create: if isOwner(userId) && isValidId(customerId) && isValidCustomer(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(customerId) && isValidCustomer(incoming(), userId) &&
                        incoming().ownerId == existing().ownerId;
        allow delete: if isOwner(userId) && isValidId(customerId);
      }

      match /orders/{orderId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(orderId);
        allow create: if isOwner(userId) && isValidId(orderId) && isValidOrder(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(orderId) && isValidOrder(incoming(), userId) &&
                        incoming().ownerId == existing().ownerId &&
                        existing().status != 'delivered';
        allow delete: if isOwner(userId) && isValidId(orderId) && existing().status == 'cancelled';

        match /items/{itemId} {
          allow list: if isOwner(userId);
          allow get: if isOwner(userId) && isValidId(itemId);
          allow create: if isOwner(userId) && isValidId(itemId) && isValidOrderItem(incoming(), userId, orderId);
          allow update: if isOwner(userId) && isValidId(itemId) && isValidOrderItem(incoming(), userId, orderId) &&
                          incoming().ownerId == existing().ownerId;
          allow delete: if isOwner(userId) && isValidId(itemId);
        }
      }

      match /expenses/{expenseId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(expenseId);
        allow create: if isOwner(userId) && isValidId(expenseId) && isValidExpense(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(expenseId) && isValidExpense(incoming(), userId) &&
                        incoming().ownerId == existing().ownerId;
        allow delete: if isOwner(userId) && isValidId(expenseId);
      }
    }
  }
}
