             data.uid == request.auth.uid &&
>>>>>>> 1aa9bfc46505429d68510ca35baadd2f6545327e
             data.pin is string && data.pin.matches('^[0-9]{4}$') &&
             (data.get('xp', 0) is number) &&
             (data.get('level', 1) is number);
    }

    function isValidProduct(data, userId) {
<<<<<<< HEAD
      return data.ownerId == userId &&
             data.name is string && data.name.size() <= 100 &&
             data.cost is number && data.cost >= 0 &&
             data.price is number && data.price >= 0;
    }

    function isValidCustomer(data, userId) {
      return data.ownerId == userId &&
